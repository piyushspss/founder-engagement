# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit a real key.
#
#     cp .env.example .env      # then edit .env
#
# Nothing in this file is required. With no key and no SDK installed, the
# deterministic product — queue, dashboard, workflow, evaluation and the entire
# test suite — runs identically and `/config → ai_layer` reports
# `available: false`.

# mock | openai | anthropic
# An unrecognised value FAILS CLOSED (UNKNOWN_LLM_PROVIDER); it never silently
# selects a different provider.
LLM_PROVIDER=mock

# --- OpenAI (optional) -------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini          # never auto-substituted for a costlier model
#
# Cost controls. These defaults bound worst-case spend per request; the
# per-run call and dollar ceilings live in scripts/openai_eval.py.
# OPENAI_MAX_OUTPUT_TOKENS=2500    # includes reasoning tokens, which are billed
# OPENAI_REASONING_EFFORT=low      # 'off' omits the parameter entirely
# OPENAI_MAX_RETRIES=0             # 0 = one attempt == one billed request
# OPENAI_TIMEOUT=60

# --- Anthropic (optional) ----------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
